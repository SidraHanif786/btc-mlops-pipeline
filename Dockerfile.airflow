FROM apache/airflow:2.9.3-python3.10
RUN pip install --no-cache-dir --default-timeout=300 --retries=10 --prefer-binary \
    numpy==1.26.4 pandas==2.2.2 requests==2.32.3
RUN pip install --no-cache-dir --default-timeout=300 --retries=10 --prefer-binary \
    scikit-learn==1.5.1 joblib==1.4.2 yfinance==0.2.43